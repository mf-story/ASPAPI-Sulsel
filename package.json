{
  "name": "aspapi-sulsel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --check app.js",
    "test": "node --test tests/admin.test.js tests/social.test.js",
    "pretest:browser": "npm run build",
    "test:browser": "node --test tests/browser.test.js",
    "admin:account": "node --env-file-if-exists=.env scripts/admin-account.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "cheerio": "^1.2.0",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide": "^0.468.0",
    "multer": "^2.5.0",
    "quill": "2.0.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vite": "^6.4.1"
  }
}
